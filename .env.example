# Server-only secret used to sign the private, browser-scoped NoticeLens session cookie.
# Leave empty for local memory mode. Set a PostgreSQL URL for persistent deployment storage.
DATABASE_URL=
# Explicit local mode; remove this line when using PostgreSQL.
NOTICE_LENS_DB=memory
SESSION_SECRET=replace-with-a-long-random-value

# Public RevenueCat Web SDK key. Configure this in Replit environment variables.
VITE_REVENUECAT_PUBLIC_KEY=
